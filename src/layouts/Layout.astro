---
type Props = {
  title: string;
  description?: string;
  ogImagePath?: string;
  noIndex?: boolean;
};

import { getImage } from "astro:assets";
import { Font } from "astro:assets";

import "@/styles/global.css";
import { siteConfig } from "@/constants";
import myImage from "../assets/bg.png";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ShareButton from "@/components/ShareButton.astro";

const optimizedImage = await getImage({ src: myImage });

const { title, description, ogImagePath, noIndex } = Astro.props;

const titleTemplate =
  Astro.url.pathname === "/" ? title : `${title} | ${siteConfig.siteName}`;
---

<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="だてんし" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titleTemplate}</title>
    <meta
      name="description"
      content={description || siteConfig.siteDefaultDescription}
    />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={titleTemplate} /><meta
      property="og:description"
      content={description || siteConfig.siteDefaultDescription}
    />
    <meta
      property="og:type"
      content={Astro.url.pathname === "/" ? "website" : "article"}
    />
    <meta property="og:url" content={Astro.url.href} />
    <meta
      property="og:image"
      content={new URL(
        ogImagePath || siteConfig.siteDefaultOGImagePath,
        siteConfig.siteUrl,
      ).toString()}
    />
    <meta name="twitter:card" content={siteConfig.twitterCardType} />
    <meta name="twitter:site" content={`@${siteConfig.twitterUserName}`} />
    {noIndex && <meta name="robots" content="noindex" />}

    <style define:vars={{ bgImg: `url(${optimizedImage.src})` }}></style>
    <Font cssVariable="--font-noto-sans-jp" />
  </head>
  <body
    class="bg-indigo-950 bg-(image:--bgImg) bg-cover bg-no-repeat bg-position-[top_center] [@media(max-aspect-ratio:1144/1536)]:bg-size-[auto_max(100%,100dvh)] font-sans text-gray-900 text-sm"
  >
    <div
      class="relative flex flex-col gap-4 pt-10 px-2 mx-auto w-full max-w-lg"
    >
      <ShareButton />
      <Header />
      <main class="flex flex-col gap-4">
        <slot />
      </main>
      {
        Astro.url.pathname !== "/" && (
          <a
            href="/"
            class="block bg-white/80 w-fit mx-auto px-4 py-2 rounded-md shadow-md hover:shadow-xl transition-shadow"
          >
            &larr; ホームに戻る
          </a>
        )
      }
      <Footer />
    </div>
  </body>
</html>
