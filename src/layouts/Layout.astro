---
type Props = {
  title: string;
  description?: string;
  ogImagePath?: string;
  noIndex?: boolean;
};

import { getImage } from "astro:assets";
import { Font } from "astro:assets";

import "@/styles/global.css";
import { siteConfig } from "@/constants";
import { copy, localeAbsoluteUrl, localeFrom, localeUrl, unlocalizedPath } from "@/i18n";
import myImage from "../assets/bg.png";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ShareButton from "@/components/ShareButton.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

const optimizedImage = await getImage({ src: myImage });

const { title, description, ogImagePath, noIndex } = Astro.props;

const locale = localeFrom(Astro.currentLocale);
const t = copy[locale];
const localeConfig = siteConfig.locales[locale];
const localizedPath = unlocalizedPath(Astro.url.pathname);
const alternateUrls = {
  ja: localeAbsoluteUrl("ja", localizedPath),
  en: localeAbsoluteUrl("en", localizedPath),
};
const isHome = localizedPath === "/";
const pageName = localeConfig.siteName;
const pageDescription = description || localeConfig.siteDefaultDescription;
const titleTemplate = isHome ? title : `${title} | ${pageName}`;
---

<html
  lang={localeConfig.lang}
  data-copied={t.copied}
  prefix="og: https://ogp.me/ns#"
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={localeConfig.appTitle} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titleTemplate}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={Astro.url.href} />
    <link
      rel="alternate"
      hreflang={siteConfig.locales.ja.lang}
      href={alternateUrls.ja}
    />
    <link
      rel="alternate"
      hreflang={siteConfig.locales.en.lang}
      href={alternateUrls.en}
    />
    <link rel="alternate" hreflang="x-default" href={alternateUrls.ja} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={pageName} />
    <meta property="og:title" content={titleTemplate} /><meta
      property="og:description"
      content={pageDescription}
    />
    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:url" content={Astro.url.href} />
    <meta
      property="og:image"
      content={new URL(
        ogImagePath || siteConfig.siteDefaultOGImagePath,
        siteConfig.siteUrl,
      ).toString()}
    />
    <meta name="twitter:card" content={siteConfig.twitterCardType} />
    <meta name="twitter:site" content={`@${siteConfig.twitterUserName}`} />
    {noIndex && <meta name="robots" content="noindex" />}

    <style define:vars={{ bgImg: `url(${optimizedImage.src})` }}></style>
    <Font cssVariable="--font-noto-sans-jp" />
  </head>
  <body
    class="bg-indigo-950 bg-(image:--bgImg) bg-cover bg-no-repeat bg-position-[top_center] [@media(max-aspect-ratio:1144/1536)]:bg-size-[auto_max(100%,100dvh)] font-sans text-gray-900 text-sm"
  >
    <div
      class="relative flex flex-col gap-4 pt-10 px-2 mx-auto w-full max-w-lg"
    >
      <ShareButton />
      <LanguageSwitcher />
      <Header />
      <main class="flex flex-col gap-4">
        <slot />
      </main>
      {
        !isHome && (
          <a
            href={localeUrl(locale, "/")}
            class="block bg-white/80 w-fit mx-auto px-4 py-2 rounded-md shadow-md hover:shadow-xl transition-shadow"
          >
            <span aria-hidden="true">&larr;</span>
            {" "}
            {t.backHome}
          </a>
        )
      }
      <Footer />
    </div>
  </body>
</html>
