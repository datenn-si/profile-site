---
import Layout from "@/layouts/Layout.astro";
import ContentBox from "@/components/ContentBox.astro";
import { getSecret } from "astro:env/server";
const EMAIL_ADDRESS = getSecret("EMAIL_ADDRESS");
---

<Layout title="メールアドレス" description="だてんしの連絡用メールアドレスを記載しています。" noIndex={true}>
  <ContentBox heading="メールアドレス">
    {
      EMAIL_ADDRESS !== undefined ? (
        <p data-copy class="cursor-pointer hover:text-gray-700 with-icon">
          <span class="icon-[mdi--content-copy] text-base" />
          {EMAIL_ADDRESS}
        </p>
        <script src="@/assets/copy"></script>
      ) : (
        <p>未設定</p>
      )
    }
  </ContentBox>
  <ContentBox heading="エンドツーエンド暗号化">
    <p>
      datenn.si ドメインのメールアドレスは Tuta
      によってホスティングされています。
    </p>
    <p>Tuta を利用することでエンドツーエンド暗号化されたやり取りができます。</p>
  </ContentBox>
</Layout>
