---
import Layout from "@/layouts/Layout.astro";
import ContentBox from "@/components/ContentBox.astro";
import { socialLinks, techStack, projects } from "@/constants";

import blogIcon from "@/assets/icon.png";
import { Image } from "astro:assets";
---

<Layout title="だてんし">
  <ContentBox>
    <ul class="grid grid-cols-3 gap-4 min-[445px]:grid-cols-4">
      <li class="hover:scale-105 hover:opacity-90 transition-[scale,opacity]">
        <a
          href="https://blog.datenn.si/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center gap-1"
        >
          <div
            class="bg-white p-4 rounded-lg flex items-center justify-center shadow-md"
          >
            <Image
              src={blogIcon}
              alt="blog.datenn.si の favicon"
              width={30}
              height={30}
              class="rounded-sm shrink-0"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <span class="text-xs text-center">ブログ</span>
        </a>
      </li>
      {
        socialLinks.map((link) => (
          <li class="hover:scale-105 hover:opacity-90 transition-[scale,opacity]">
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center justify-center gap-1"
            >
              <div class="bg-white p-4 rounded-lg flex items-center justify-center shadow-md">
                <span
                  class={`text-3xl ${link.hexClass || ""} ${link.iconClass}`}
                />
              </div>
              <span class="text-xs text-center">{link.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </ContentBox>
  <ContentBox heading="自己紹介">
    <p>
      フロントエンドは Astro.js や Tailwind CSS が得意です。ローカル画像生成には
      SD WebUI Forge Neo を使っています。
    </p>
  </ContentBox>
  <ContentBox heading="Tech Stack">
    <ul class="flex flex-wrap gap-2">
      {
        techStack.map((item) => (
          <li class="bg-white px-3 py-2 rounded-lg flex items-center shadow-md gap-2">
            <span class="icon-backing">
              <span class={`text-xl ${item.hexClass} ${item.iconClass}`} />
            </span>
            <span class="text-sm">{item.name}</span>
          </li>
        ))
      }
    </ul>
  </ContentBox>
  <ContentBox heading="連絡先">
    <p>
      <a
        href="https://x.com/datenn_si"
        target="_blank"
        rel="noopener noreferrer">X</a
      > や <a
        href="https://bsky.app/profile/datenn.si"
        target="_blank"
        rel="noopener noreferrer">Bluesky</a
      > の DM も開放しています。
    </p>
    <ul>
      <li>
        メールアドレス: <a href="/email">確認する</a>
      </li>
      <li>
        Discord: <a
          href="https://discord.com/users/1554737723154235487"
          target="_blank"
          rel="noopener noreferrer">datenn.si</a
        >
      </li>
      <li class="flex items-center gap-0.5">
        <span>Signal:</span><span
          data-copy
          class="cursor-pointer hover:text-gray-700 with-icon"
          ><span class="icon-[mdi--content-copy] text-base"
          ></span>@datenn.40</span
        >
      </li>
      <li class="flex items-center gap-0.5">
        <span>Session:</span><span
          data-copy
          class="with-icon w-[calc(100%-3rem)] cursor-pointer hover:text-gray-700"
          ><span class="icon-[mdi--content-copy] text-base"></span><span
            class="w-[calc(100%-1.25rem)] overflow-x-clip text-ellipsis"
            >05eb9410b24269af57679d15e86cdb7a551ded3bd37cf3a60342327fca97a1571f</span
          ></span
        >
      </li>
    </ul>
    <script src="@/assets/copy"></script>
  </ContentBox>
  <ContentBox heading="作ったもの">
    <ul class="flex flex-col gap-2">
      {
        projects.map((project) => (
          <li class="bg-white px-4 py-2 rounded-lg flex flex-col shadow-md gap-1">
            <h3 class="font-bold">{project.name}</h3>
            <p>{project.description}</p>
            <ul class="flex gap-x-2 gap-y-1 flex-wrap">
              {project.mainLang && (
                <li class="with-icon">
                  <span
                    class="inline-block w-4 h-4 rounded-full"
                    style={{ backgroundColor: project.mainLang.color }}
                  />
                  {project.mainLang.name}
                </li>
              )}
              {project.hpUrl && (
                <li>
                  <a
                    href={project.hpUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="with-icon"
                  >
                    <span class="icon-[mdi--open-in-new] text-base align-middle" />
                    HP
                  </a>
                </li>
              )}
              {project.repoUrl && (
                <li>
                  <a
                    href={project.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="with-icon"
                  >
                    <span class="icon-[mdi--open-in-new] text-base align-middle" />
                    リポジトリ
                  </a>
                </li>
              )}
            </ul>
          </li>
        ))
      }
    </ul>
  </ContentBox>
</Layout>
